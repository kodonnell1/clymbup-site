<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>ClymbUp SMS Opt-In</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <style>
    :root {
      --bg-dark: #0f172a;         /* Site dark background */
      --card: #020617;           /* Slightly lighter than bg */
      --primary: #2563eb;        /* Blue accent */
      --primary-dark: #1e40af;
      --text: #e5e7eb;
      --muted: #9ca3af;
      --border: #1e293b;
      --success-bg: #052e1b;
      --success-border: #10b981;
      --success-text: #6ee7b7;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--bg-dark);
      color: var(--text);
      font-family: system-ui, -apple-system, BlinkMacSystemFont,
                   "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 48px 16px;
    }

    .container {
      width: 100%;
      max-width: 520px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 36px;
      box-shadow: 0 20px 60px rgba(0,0,0,.6);
    }

    h1 {
      margin-top: 0;
      font-size: 26px;
      color: #ffffff;
      margin-bottom: 14px;
    }

    p {
      font-size: 15px;
      line-height: 1.6;
      color: var(--text);
      margin-bottom: 22px;
    }

    label {
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 6px;
      display: block;
      color: #ffffff;
    }

input[type="tel"] {
  width: 100%;
  padding: 12px;
  font-size: 16px;
  border-radius: 6px;
  border: 1px solid var(--border);
  background: #ffffff;        /* <-- white input */
  color: #020617;             /* <-- dark text */
  margin-bottom: 20px;
}

input[type="tel"]::placeholder {
  color: #6b7280;             /* subtle gray placeholder */
}

input[type="tel"]:focus {
  outline: none;
  border-color: var(--primary);
}

    .consent {
      display: flex;
      gap: 10px;
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 22px;
    }

    .consent input {
      margin-top: 3px;
    }

    button {
      width: 100%;
      background: var(--primary);
      color: #ffffff;
      border: none;
      padding: 14px;
      font-size: 16px;
      font-weight: 600;
      border-radius: 8px;
      cursor: pointer;
    }

    button:hover {
      background: var(--primary-dark);
    }

    .confirmation {
      display: none;
      margin-top: 22px;
      padding: 14px;
      background: var(--success-bg);
      border: 1px solid var(--success-border);
      color: var(--success-text);
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
    }

    .footer {
      margin-top: 28px;
      font-size: 12px;
      color: var(--muted);
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .footer a {
      color: var(--muted);
      text-decoration: none;
    }

    .footer a:hover {
      color: #ffffff;
      text-decoration: underline;
    }
  </style>
</head>

<body>
  <div class="container">
    <h1>SMS Notifications</h1>

    <p>
      Enter your mobile number to receive SMS messages from
      <strong>ClymbUp.ai</strong> related to demos, follow-ups, and service
      updates.
    </p>

    <form id="sms-form">
      <label for="phone">Mobile Phone Number</label>
      <input
        type="tel"
        id="phone"
        name="phone"
        placeholder="e.g. 760-555-1234"
        required
      />

      <div class="consent">
        <input type="checkbox" id="consent" required />
        <label for="consent">
          I agree to receive SMS messages from ClymbUp.ai. Message and data
          rates may apply. Message frequency varies. Reply STOP to unsubscribe
          or HELP for help.
        </label>
      </div>

      <button type="submit">Submit</button>
    </form>

    <div id="confirmation" class="confirmation">
      Thanks — you’re opted in. Reply STOP to unsubscribe or HELP for help.
    </div>

    <div class="footer">
      <a href="/">Home</a>
      <a href="/privacy">Privacy Policy</a>
      <a href="/sms">SMS Disclosure</a>
    </div>
  </div>

  <script>
    (function () {
      const form = document.getElementById("sms-form");
      const phone = document.getElementById("phone");
      const consent = document.getElementById("consent");
      const confirmation = document.getElementById("confirmation");

      form.addEventListener("submit", function (e) {
        e.preventDefault();

        confirmation.style.display = "block";

        phone.value = "";
        consent.checked = false;

        confirmation.scrollIntoView({ behavior: "smooth" });
      });
    })();
  </script>
</body>
</html>

